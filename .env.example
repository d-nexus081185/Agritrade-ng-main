# Copy this file to .env and adjust the values.

# Database connection. SQLite works out of the box for local development.
# For PostgreSQL, change `provider` in prisma/schema.prisma to "postgresql" and use e.g.
# DATABASE_URL="postgresql://user:password@localhost:5432/agritrade?schema=public"
DATABASE_URL="file:./dev.db"

# Public base URL, used to build password-reset links.
APP_URL="http://localhost:3000"

# Sign in / sign up with Google and Facebook. Leave blank to hide a provider's button in production
# (in development the buttons always show and explain what's missing).
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application).
#   Authorised redirect URI: {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: developers.facebook.com → My Apps → Create app → Facebook Login.
#   Valid OAuth Redirect URI: {APP_URL}/api/auth/oauth/facebook/callback  (request the "email" permission)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Password given to every sample account created by `npm run db:seed`.
# Choose your own; the seed script refuses to run without it.
SEED_DEMO_PASSWORD=""

# Payments (escrow). Buyers pay AgriTrade through Paystack; money is held until the buyer
# confirms delivery. Use a test key (sk_test_…) until you go live. Without a key, development
# uses a simulated checkout, and production refuses payments.
# Also set the webhook URL in the Paystack dashboard to {APP_URL}/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=""

# AgriTrade's commission (percent) deducted from the seller's share when escrow is released.
PLATFORM_FEE_PERCENT="0"

# Where uploaded listing photos are stored (outside /public so they are served through
# an authenticated-safe route handler). Use object storage in serverless deployments.
UPLOAD_DIR="./uploads"
